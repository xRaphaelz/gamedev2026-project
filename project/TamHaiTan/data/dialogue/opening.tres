[gd_resource type="Resource" script_class="Dialogue" format=3]

[ext_resource type="Script" path="res://scripts/data/dialogue.gd" id="1_dlg"]

[resource]
script = ExtResource("1_dlg")
title = "ส้มตำป้าแดง"
lines = PackedStringArray("บรรยาย: ตลาดเช้าหน้าปากซอย มีร้านส้มตำเล็ก ๆ ร้านหนึ่งชื่อ ส้มตำป้าแดง", "บรรยาย: ป้าแดงขายมากว่ายี่สิบปี ไม่เคยปิดร้านสักวัน... จนกระทั่งเช้าวันนี้", "ต้อม: (เสียงโทรศัพท์) ฮัลโหล ป้าแดงเหรอครับ?", "ป้าแดง: ต้อม... ป้าอยู่โรงพยาบาลนะ หมอให้นอนพักหลายวันเลย", "ต้อม: หา! ป้าเป็นอะไรมากไหมครับ", "ป้าแดง: ไม่เป็นไรมากหรอก แต่ร้านน่ะสิ ลูกค้าประจำมารอกินทุกวัน", "ป้าแดง: ต้อมช่วยเปิดร้านแทนป้าสักพักได้ไหม", "ต้อม: ผมเนี่ยนะ!? ผมตำส้มตำไม่เป็นเลยนะป้า", "ป้าแดง: ไม่ยากหรอก ป้าจะวิดีโอคอลมาสอนทุกเย็น", "ป้าแดง: จำไว้นะ ร้านเราอยู่ได้เพราะลูกค้ารีวิว อย่าให้ใครรอจนกลับบ้านไปมือเปล่า", "ต้อม: ได้ครับป้า! ผมจะดูแลร้านให้ดีที่สุดจนกว่าป้าจะกลับมา", "บรรยาย: และนี่คือวันแรกของต้อม กับร้านส้มตำป้าแดง...")
